---
import { menuMain, footer } from "~/data/menus";
import { siteName } from "~/data/config";
import appStore from "~/assets/images/app_store.svg";
import playStore from "~/assets/images/play_store.svg";

const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-green text-white">
	<div class="container pt-16 pb-8">
		<p class="text-center font-bold text-4xl text-white">
			ファミリアノート
		</p>

		<nav
			class="flex flex-col sm:flex-row items-center justify-center gap-x-12 gap-y-3 font-medium mt-6"
			aria-label="Footer"
		>
			{
				menuMain.map((item) => (
					<a href={item.url} class="hover:underline">
						{item.name}
					</a>
				))
			}
		</nav>

		<nav
			class="flex flex-col sm:flex-row items-center justify-center gap-x-12 gap-y-3 font-medium mt-2"
			aria-label="Footer"
		>
			{
				footer.map((item) => (
					<a href={item.url} class="hover:underline">
						{item.name}
					</a>
				))
			}
		</nav>

		<div
			class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4"
		>
			<a
				href="https://apps.apple.com/us/app/id6753338947"
				target="_blank"
				rel="noopener noreferrer"
			>
				<img
					src={appStore.src}
					alt="App Storeからダウンロード"
					class="h-12 w-auto hover:opacity-80 transition"
					height="35"
				/>
			</a>

			<a
				href="https://play.google.com/store/apps/details?id=jp.co.kiiro.familiarnote"
				target="_blank"
				rel="noopener noreferrer"
			>
				<img
					src={playStore.src}
					alt="Google Playeからダウンロード"
					class="h-12 w-auto hover:opacity-80 transition"
					height="35"
				/>
			</a>
		</div>

		<p class="mt-10 text-center text-sm">
			&copy; {currentYear}
			{siteName}. All rights reserved.
		</p>
	</div>
</footer>
